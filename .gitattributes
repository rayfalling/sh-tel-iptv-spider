# 统一使用 LF 入库：本项目要在 Linux/OpenWrt 上编译运行，
# shell 脚本、systemd 单元带 CRLF 会直接执行失败（bad interpreter: /bin/bash^M）。
* text=auto eol=lf

*.sh      text eol=lf
*.service text eol=lf
*.timer   text eol=lf
*.env     text eol=lf
*.go      text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.html    text eol=lf
*.js      text eol=lf
*.css     text eol=lf
*.txt     text eol=lf

# 二进制文件不做转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.db binary
