# /etc/default/iptv-routes
# iptv-routes.sh 的可选配置（全部可省略，省略时用脚本内默认值）

# IPTV 专网网卡
IPTV_IFACE=eth1

# 需要走专网的网段（空格分隔）
#  - 222.68.208.0/24 认证服务器 222.68.208.73:7001
#  - 218.83.0.0/16   EPG 门户（认证时动态下发的主机，如 218.83.165.40:8084）
#  - 124.75.0.0/16   R4K/OTT 跳转主机
#  - 10.192.0.0/16   IPTV 中间件
#  - 180.168.0.0/16  保留（部分上海电信地址段）
# IPTV_ROUTES="222.68.208.0/24 218.83.0.0/16 124.75.0.0/16 10.192.0.0/16 180.168.0.0/16"

# 手工指定网关（省略时自动从专网网卡的 DHCP 默认路由获取）
# IPTV_GW=30.142.248.1
